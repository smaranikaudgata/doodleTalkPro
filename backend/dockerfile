FROM python:3.11-slim

WORKDIR /app

# Install system tools needed for database connections
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python libraries from our shopping list
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend code later
COPY . .